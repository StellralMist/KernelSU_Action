CONFIG_ENV=config.env

# 源码设置：指向你合并了分卷后的那个仓库
KERNEL_SOURCE=https://github.com/pix106/android_kernel_xiaomi_southwest-4.19
KERNEL_SOURCE_BRANCH=main
KERNEL_CONFIG=clover_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true
# 增加 LLVM 兼容性命令
EXTRA_CMDS:LLVM=1 LLVM_IAS=1

# Clang 设置：强烈建议使用 Proton-Clang 以适配 4.19 内核
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/kdrag0n/proton-clang
CUSTOM_CLANG_BRANCH=master
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

## AOSP 留空作为回退参考
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784d

# GCC 设置：4.19 内核编译必开
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

# SukiSU Ultra 设置
# 记得按我之前说的，在 .yml 里把克隆地址换成 SukiSU-Ultra
ENABLE_KERNELSU=true
KERNELSU_TAG=main
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# 内核特性：SukiSU Ultra 必须开启
DISABLE-LTO=false
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
# 自动为非 GKI 内核应用 KSU 补丁
APPLY_KSU_PATCH=true
REMOVE_UNUSED_PACKAGES=true

# AnyKernel3 打包：开启后会自动生成刷机 ZIP 包
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# 编译优化
ENABLE_CCACHE=true

# 镜像输出
NEED_DTBO=false
# 制作 boot.img，方便 Fastboot 刷入
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/StellralMist/KernelSU_action/main/boot/boot.img
