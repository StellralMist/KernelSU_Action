KERNEL_SOURCE=https://github.com/pix106/android_kernel_xiaomi_southwest-4.19
KERNEL_SOURCE_BRANCH=main
KERNEL_CONFIG=clover_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# 建议开启自定义 Clang，4.19 用 Proton 效果最好
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/kdrag0n/proton-clang
CUSTOM_CLANG_BRANCH=master

# KernelSU开启
ENABLE_KERNELSU=true
KERNELSU_TAG=main

# 自动注入配置项
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
# 4.19 必须开启补丁模式，否则手动集成很痛苦
APPLY_KSU_PATCH=true

# 开启 Boot 镜像制作，方便直接下载刷入
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/StellralMist/KernelSU_action/main/boot/boot.img
